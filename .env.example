# A partir desta versão, o .env guarda só credenciais e tokens. Tudo o mais
# (textos do site, telefones, imagens, URLs de API das unidades, feature
# flags/módulos) é editado em runtime pelos painéis /admin (cliente da
# clínica) e /superadmin (você) — ver README.md.

# Login do painel /admin (edita conteúdo do site: textos, imagens, telefones,
# links). Senha em texto puro.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Login do painel /superadmin (liga/desliga módulos, edita URLs de API das
# unidades). Senha em texto puro.
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=

# Chave usada para assinar o cookie de sessão do login (/admin e
# /superadmin). Gere um valor aleatório, ex.: openssl rand -hex 32
SESSION_SECRET=

# Chave usada para criptografar em repouso o settings.json (contém as URLs
# de API das unidades) — necessário porque o driver Vercel Blob só oferece
# acesso público. Gere com: openssl rand -hex 32
SETTINGS_ENC_KEY=

# Chave da OpenAI usada pelo chat com IA (Sofia, /chat). Sem ela o chat cai
# em modo de fallback. Gere em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opcional — modelo usado pela Sofia (padrão: gpt-4.1-mini)
OPENAI_MODEL=

# Só necessário se o site for hospedado na Vercel (serverless, sem disco
# persistente) — cria em https://vercel.com/docs/storage/vercel-blob. Sem
# esta variável, o painel usa arquivos em /data (funciona em VPS/servidor
# próprio, mas não persiste entre deploys na Vercel).
BLOB_READ_WRITE_TOKEN=
