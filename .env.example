# Plataforma multi-empresa: cada clínica ("empresa") cadastrada no
# /superadmin mora num subdomínio de PLATFORM_DOMAIN (ex.: clinica-x.SEU
# DOMÍNIO), com banco, conteúdo e login de admin próprios — tudo isso é
# gerado automaticamente ao criar a empresa. Este .env só guarda o que é
# global da plataforma (login do superadmin, chaves de sessão/criptografia
# e o domínio base) — ver README.md.

# Domínio da plataforma (sem subdomínio). Cada empresa fica em
# <slug>.PLATFORM_DOMAIN — aponte um DNS coringa (*.PLATFORM_DOMAIN) pro IP
# deste servidor. Sem esta variável (ex.: rodando em localhost em dev), o
# app trata qualquer host como domínio raiz — só dá pra acessar /superadmin,
# nenhuma empresa fica acessível por subdomínio (mas funciona por domínio
# próprio, se configurado).
PLATFORM_DOMAIN=

# Login do painel /superadmin (cadastra empresas, domínios, integrações).
# Só funciona no domínio raiz da plataforma. Senha em texto puro.
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=

# Chave usada para assinar o cookie de sessão do login (/admin de cada
# empresa e /superadmin). Gere um valor aleatório, ex.: openssl rand -hex 32
SESSION_SECRET=

# Chave usada para criptografar em repouso o documento "settings" de cada
# empresa (contém a URL da API do sistema e a chave da OpenAI). Gere com:
# openssl rand -hex 32
SETTINGS_ENC_KEY=

# Modelo padrão da OpenAI quando uma empresa não tiver um definido no
# /superadmin (opcional — padrão: gpt-4.1-mini). A chave da OpenAI em si é
# por empresa, configurada ao criar/editar cada uma no /superadmin.
OPENAI_MODEL=
