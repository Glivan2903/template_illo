# Domínio raiz da plataforma (ex.: suaplataforma.com.br) — cada empresa fica em <slug>.PLATFORM_DOMAIN
PLATFORM_DOMAIN=

# Login do /superadmin
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=

# Gere os dois com: openssl rand -hex 32
SESSION_SECRET=
SETTINGS_ENC_KEY=

# Opcional — modelo padrão da OpenAI quando a empresa não define um
OPENAI_MODEL=
